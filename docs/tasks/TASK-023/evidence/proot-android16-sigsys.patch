diff --git a/src/tracee/event.c b/src/tracee/event.c
index ce59f07..3f28752 100644
--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -602,7 +602,20 @@ static int handle_tracee_event_kernel_4_8(Tracee *tracee, int tracee_status)
 			break;
 
 		default:
-			/* Deliver this signal as-is.  */
+			/* Android 16+ untrusted_app seccomp filters trap guest
+			 * syscalls that PRoot can not rewrite in time (the
+			 * seccomp filter runs before the syscall-entry ptrace
+			 * stop), e.g. rseq(2) issued by the guest glibc.  The
+			 * resulting SIGSYS stops are seccomp artifacts: suppress
+			 * them so the aborted syscall simply returns -ENOSYS
+			 * instead of killing the whole session.  Never swallow
+			 * SIGSYS when PRoot's own seccomp acceleration is on,
+			 * since that machinery relies on SIGSYS stops. */
+			if (signal == SIGSYS && tracee->seccomp != ENABLED)
+				signal = 0;
+			else
+				/* Deliver this signal as-is.  */
+				break;
 			break;
 		}
 	}
@@ -831,7 +844,20 @@ int handle_tracee_event(Tracee *tracee, int tracee_status)
 			break;
 
 		default:
-			/* Deliver this signal as-is.  */
+			/* Android 16+ untrusted_app seccomp filters trap guest
+			 * syscalls that PRoot can not rewrite in time (the
+			 * seccomp filter runs before the syscall-entry ptrace
+			 * stop), e.g. rseq(2) issued by the guest glibc.  The
+			 * resulting SIGSYS stops are seccomp artifacts: suppress
+			 * them so the aborted syscall simply returns -ENOSYS
+			 * instead of killing the whole session.  Never swallow
+			 * SIGSYS when PRoot's own seccomp acceleration is on,
+			 * since that machinery relies on SIGSYS stops. */
+			if (signal == SIGSYS && tracee->seccomp != ENABLED)
+				signal = 0;
+			else
+				/* Deliver this signal as-is.  */
+				break;
 			break;
 		}
 	}
